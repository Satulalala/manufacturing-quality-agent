# Copy these values into the environment. This project does not auto-load .env.
OLLAMA_BASE_URL=http://localhost:11434
QUALITY_LLM_MODEL=qwen3:4b-q4_K_M
# Default to a quick response; raise this only when local inference is consistently slower.
QUALITY_LLM_TIMEOUT=60
OLLAMA_EMBED_MODEL=bge-m3
# Optional neural reranking: an existing local CrossEncoder model directory.
# RAG_RERANKER_MODEL=D:/Models/your-reranker
# Tracing is opt-in. This project-specific switch prevents global SDK variables
# from uploading a run accidentally. Only enable after deciding which data may be uploaded.
QUALITY_LANGSMITH_TRACING=false
LANGSMITH_PROJECT=manufacturing-quality-agent
# LANGSMITH_API_KEY=
